# General
NODE_ENV=development
PORT=4000

# Provider switch
AI_PROVIDER=mock
VISION_PROVIDER=mock
IMAGE_PROVIDER=mock
BACKGROUND_PROVIDER=mock
REVIEW_PROVIDER=mock

# Storage
STORAGE_DRIVER=json
SQLITE_DB_PATH=backend/data/app.sqlite
SQLITE_AUTO_MIGRATE=false
SQLITE_BACKUP_JSON_BEFORE_MIGRATE=true

# Common vision settings
VISION_TIMEOUT_MS=300000
VISION_MODEL=
VISION_RECOGNITION_MODE=balanced
VISION_BATCH_SIZE=4
VISION_RETRY_COUNT=1
VISION_FAST_TIMEOUT_MS=90000
VISION_IMAGE_MAX_WIDTH=1280
VISION_IMAGE_QUALITY=75
VISION_VISIBLE_TEXT_LIMIT_PER_IMAGE=10
VISION_VISIBLE_TEXT_TOTAL_LIMIT=80

# Review provider
# REVIEW_PROVIDER=mock|gemini|openai|qwen|vision
REVIEW_TIMEOUT_MS=180000
REVIEW_MODEL=

# Batch queue
BATCH_DEFAULT_CONCURRENCY=2
BATCH_MAX_CONCURRENCY=4
BATCH_JOB_TIMEOUT_MS=600000
BATCH_LOCK_TTL_MS=900000
BATCH_AUTO_RETRY_ENABLED=false
BATCH_MAX_RETRY_PER_JOB=1
BATCH_RETRY_DELAY_MS=5000
BATCH_RETRY_BACKOFF=linear
BATCH_RETRYABLE_CODES=JOB_TIMEOUT,HTTP_ERROR,PARSE_ERROR,PROVIDER_RATE_LIMIT,ECONNRESET

# Safe local import scanner
IMPORT_ROOT_DIR=
IMPORT_SCAN_ENABLED=false
IMPORT_SCAN_MAX_DEPTH=2
IMPORT_SCAN_MAX_SKU=200
IMPORT_SCAN_ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

# Local estimated cost per provider call. Defaults are 0 and do not represent real bills.
COST_VISION_GEMINI_PER_CALL=0
COST_VISION_OPENAI_PER_CALL=0
COST_VISION_QWEN_PER_CALL=0
COST_IMAGE_OPENAI_PER_CALL=0
COST_REVIEW_GEMINI_PER_CALL=0
COST_REVIEW_OPENAI_PER_CALL=0
COST_REVIEW_QWEN_PER_CALL=0
COST_MATTING_EXTERNAL_PER_CALL=0

# Image generation provider switch
IMAGE_TIMEOUT_MS=300000
IMAGE_RETRY_COUNT=1
IMAGE_MODEL=
IMAGE_OUTPUT_SIZE=1536x1536
OPENAI_IMAGE_EDIT_ENABLED=false
OPENAI_IMAGE_EDIT_MODEL=gpt-image-2
OPENAI_SUBJECT_COMPOSITE_ENABLED=true
IMAGE_EDIT_OUTPUT_SIZE=1536x1536
IMAGE_REFERENCE_MAX_WIDTH=1536
IMAGE_REFERENCE_QUALITY=90
MATTING_PROVIDER=sharp
REMBG_COMMAND=
REMBG_MODEL=u2net
REMBG_HOME=
# Only enable after explicitly reviewing the installed model's license; setup script records per-model consent.
REMBG_MODEL_LICENSE_ACCEPTED=false
REMBG_TIMEOUT_MS=240000
REMBG_ALPHA_MATTING=true
REMBG_COLOR_DECONTAMINATION=true
MATTING_TIMEOUT_MS=120000
MATTING_RETRY_COUNT=1
MATTING_FALLBACK_PROVIDER=sharp
MATTING_API_KEY=
MATTING_BASE_URL=
MATTING_MODEL=

# Optional real background generation providers (scaffolded for v1.9)
# IMAGE_PROVIDER=real
# BACKGROUND_PROVIDER=qwen|openai|gemini|custom
QWEN_IMAGE_MODEL=
OPENAI_IMAGE_MODEL=gpt-image-2
GEMINI_IMAGE_MODEL=
BACKGROUND_API_KEY=
CUSTOM_BACKGROUND_MODEL=

# Qwen / DashScope OpenAI-compatible Vision
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-vl-max-latest

# OpenAI Vision
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-4.1-mini

# Gemini Vision
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_VISION_MODEL=gemini-2.5-flash

# Standalone Web account protection defaults to enabled. Desktop uses its own local session.
WEB_AUTH_ENABLED=true
# Public deployment: reverse proxy HTTPS to 127.0.0.1:4000; initialize admin on server localhost first.
WEB_PUBLIC_ORIGIN=
# 32 random bytes encoded as 64 hex chars. Keep outside source and maintain a secure backup.
WEB_CREDENTIAL_KEY=
# Array of official OAuth application configurations. Never put credentials into frontend VITE_*.
# Each entry: id,name,clientId,clientSecret,authorizationUrl,tokenUrl,revocationUrl,redirectUri,scopes[].
# Register redirectUri as https://YOUR_HOST/api/platform/shops/callback in the official console.
SHOP_OAUTH_PROVIDERS=[]
