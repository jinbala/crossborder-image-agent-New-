{
  "name": "crossborder-image-desktop",
  "version": "0.29.0",
  "description": "跨境图片运营工作台 Windows 客户端",
  "author": "Crossborder Workbench",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "stage": "node scripts/stage.mjs",
    "start": "npm run stage && node scripts/launch.mjs",
    "smoke": "npm run stage && node scripts/launch.mjs --smoke-test",
    "test": "node --test tests/*.test.cjs",
    "native": "electron-builder install-app-deps",
    "pack": "npm run stage && electron-builder --dir --win --x64",
    "dist": "npm run stage && electron-builder --win nsis portable --x64"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "archiver": "^7.0.1",
    "axios": "^1.18.0",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.22.3",
    "multer": "^2.4.0",
    "nanoid": "^5.1.16",
    "openai": "^6.39.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "electron": "41.10.6",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "cn.crossborder.imageworkbench",
    "productName": "跨境图片工作台",
    "protocols": [
      {
        "name": "Crossborder Workbench",
        "schemes": [
          "crossborder-workbench"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**",
      "runtime/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node",
      "**/sharp/**",
      "**/@img/**"
    ],
    "npmRebuild": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "artifactName": "Crossborder-Workbench-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Crossborder-Workbench-Portable-${version}.${ext}"
    }
  }
}
